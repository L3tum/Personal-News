# FreshRSS
FRESHRSS_URL=http://freshrss:8080
FRESHRSS_USERNAME=admin
FRESHRSS_PASSWORD=your_password

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_api_key_if_needed
QDRANT_COLLECTION=articles
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
CONTEXT_WINDOW_DAYS=30
RAG_TOP_K=5

# Ollama (LLM)
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1

# Email (SMTP)
SMTP_HOST=your.smtp.server
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_FROM=digest@yourdomain.com

# Users
USERS=[
  {
    "name": "You",
    "freshrss_user": "you",
    "email": "you@example.com",
    "shared_feeds": []
  },
  {
    "name": "Girlfriend",
    "freshrss_user": "gf",
    "email": "gf@example.com",
    "shared_feeds": []
  }
]

# Cron schedule
CRON_TIME=06:00
CRON_TIMEZONE=UTC
