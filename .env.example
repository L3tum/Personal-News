# FreshRSS (Fever API)
#
# FRESHRSS_URL: base URL of your FreshRSS instance (no trailing slash needed).
# FRESHRSS_API_PASSWORD: fallback API password. The Fever API authenticates with a
# SEPARATE per-user "API password" — NOT the web login password. Set it for each
# user in the FreshRSS web UI: Settings → Profile → "API password" (the admin
# must first enable "Allow API access" in system settings → Authentication).
#
# NOTE: FRESHRSS_PASSWORD still works as a deprecated fallback for
# FRESHRSS_API_PASSWORD.
FRESHRSS_URL=http://freshrss:8080
FRESHRSS_API_PASSWORD=your_api_password

# Qdrant
QDRANT_URL=http://qdrant:6334
QDRANT_API_KEY=your_api_key_if_needed
QDRANT_COLLECTION=articles
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_URL=http://ollama:11434   # OpenAI-compatible endpoint (e.g., Ollama's /v1/embeddings)
EMBEDDING_DIM=768
CONTEXT_WINDOW_DAYS=30
RAG_TOP_K=5

# Ollama (LLM)
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1

# LibreTranslate (self-hosted translation service)
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=  # optional, leave empty if not using an API key

# Email (SMTP)
SMTP_HOST=your.smtp.server
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_FROM=digest@yourdomain.com

# Users
# Each digest user maps to their own FreshRSS account (their own feeds).
# freshrss_api_password must be that user's FreshRSS *API password* (Settings →
# Profile → "API password" in the FreshRSS web UI), not the login password.
# If freshrss_api_password is omitted (null), the global FRESHRSS_API_PASSWORD
# is used — this works when all FreshRSS users share the same API password.
USERS=[
  {
    "name": "You",
    "freshrss_username": "you",
    "freshrss_api_password": "your_api_password_here",
    "email": "you@example.com",
    "target_language": null  # no translation, receive original language summaries
  },
  {
    "name": "Girlfriend",
    "freshrss_username": "gf",
    "freshrss_api_password": "gf_api_password",
    "email": "gf@example.com",
    "target_language": "en"  # receive English translations
  }
]

# Cron schedule
CRON_TIME=06:00
CRON_TIMEZONE=UTC
