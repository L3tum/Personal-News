# FreshRSS
FRESHRSS_URL=http://freshrss:8080
FRESHRSS_USERNAME=admin
FRESHRSS_PASSWORD=your_password

# Qdrant
QDRANT_URL=http://qdrant:6334
QDRANT_API_KEY=your_api_key_if_needed
QDRANT_COLLECTION=articles
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_URL=http://ollama:11434   # OpenAI-compatible endpoint (e.g., Ollama's /v1/embeddings)
EMBEDDING_DIM=768
CONTEXT_WINDOW_DAYS=30
RAG_TOP_K=5

# Ollama (LLM)
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.1

# LibreTranslate (self-hosted translation service)
LIBRETRANSLATE_URL=http://libretranslate:5000
LIBRETRANSLATE_API_KEY=  # optional, leave empty if not using an API key

# Email (SMTP)
SMTP_HOST=your.smtp.server
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_password
SMTP_FROM=digest@yourdomain.com

# Users
# Each user must have their own FreshRSS username and password for the greader.php API.
# If freshrss_password is omitted (null), the global FRESHRSS_USERNAME/PASSWORD will be used.
USERS=[
  {
    "name": "You",
    "freshrss_username": "you",
    "freshrss_password": "your_password_here",
    "email": "you@example.com",
    "target_language": null  # no translation, receive original language summaries
  },
  {
    "name": "Girlfriend",
    "freshrss_username": "gf",
    "freshrss_password": "gf_password",
    "email": "gf@example.com",
    "target_language": "en"  # receive English translations
  }
]

# Cron schedule
CRON_TIME=06:00
CRON_TIMEZONE=UTC
